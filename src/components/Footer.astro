---
import { execSync } from 'node:child_process';
import { localizePath } from '../data/i18n';
import { footerStrings, resolveLocale } from '../data/ui-i18n';

interface Props {
  /** Locale for the privacy link. Defaults to French (site defaultLocale). */
  lang?: string;
}

const { lang } = Astro.props;
const locale = resolveLocale(lang ?? 'fr');
const t = footerStrings(locale);
const privacyHref = localizePath(locale, '/data-protection');

// Evaluated at build/dev time so it stays visible locally and on CI.
const builtAt = new Date();
// UTC so CI and local timestamps stay comparable.
const buildDate = builtAt.toISOString().replace('T', ' ').slice(0, 16) + ' UTC';

function resolveCommitSha(): string {
  const fromEnv = process.env.GITHUB_SHA || process.env.COMMIT_SHA;
  if (fromEnv) return fromEnv.slice(0, 7);
  try {
    return execSync('git rev-parse --short HEAD', {
      encoding: 'utf8',
      stdio: ['ignore', 'pipe', 'ignore'],
    }).trim();
  } catch {
    return '';
  }
}

const commitSha = resolveCommitSha();
const buildLabel = commitSha
  ? `Built ${buildDate} · ${commitSha}`
  : `Built ${buildDate}`;
---
<footer class="bg-chrome border-t-2 border-on-chrome/20 mt-xl">
  <div class="w-full px-margin py-lg max-w-7xl mx-auto flex flex-col gap-md">
    <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-md">
      <div class="text-sm font-body text-on-chrome leading-relaxed space-y-1 max-w-3xl">
        <p>
          Belgische Informatica-olympiade - Olympiade belge d’Informatique (beOI) ASBL/VZW
        </p>
        <p>
          Celestijnenlaan 200A bus 4078, 3001 Leuven
        </p>
        <p>
          info@be-oi.be
        </p>
        <p>BTW/TVA BE 0849.738.707</p>
      </div>
      <div class="flex flex-col gap-sm sm:items-end shrink-0">
        <div class="flex items-center gap-sm">
          <a
            href="https://www.facebook.com/beoi.contest"
            class="text-on-chrome hover:opacity-80"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={t.facebook}
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              width="1.25rem"
              height="1.25rem"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H8v-3h2V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1v2h3v3h-3v6.95c5.05-.5 9-4.76 9-9.95z"
              ></path>
            </svg>
          </a>
          <a
            href="https://www.instagram.com/beoi_official/"
            class="text-on-chrome hover:opacity-80"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={t.instagram}
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              width="1.25rem"
              height="1.25rem"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M7.8 2h8.4C19.4 2 22 4.6 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8C4.6 22 2 19.4 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2m-.2 2A3.6 3.6 0 0 0 4 7.6v8.8C4 18.39 5.61 20 7.6 20h8.8a3.6 3.6 0 0 0 3.6-3.6V7.6C20 5.61 18.39 4 16.4 4H7.6m9.65 1.5a1.25 1.25 0 0 1 1.25 1.25A1.25 1.25 0 0 1 17.25 8 1.25 1.25 0 0 1 16 6.75a1.25 1.25 0 0 1 1.25-1.25M12 7a5 5 0 0 1 5 5 5 5 0 0 1-5 5 5 5 0 0 1-5-5 5 5 0 0 1 5-5m0 2a3 3 0 0 0-3 3 3 3 0 0 0 3 3 3 3 0 0 0 3-3 3 3 0 0 0-3-3z"
              ></path>
            </svg>
          </a>
        </div>
        <p class="text-sm font-body sm:text-right">
          <a
            href={privacyHref}
            class="text-on-chrome underline underline-offset-2 hover:decoration-2"
          >
            {t.dataProtection}
          </a>
        </p>
        <p
          class="text-[0.7rem] font-body text-on-chrome/50 tracking-wide sm:text-right"
          title={builtAt.toISOString()}
        >
          {buildLabel}
        </p>
      </div>
    </div>
  </div>
</footer>
