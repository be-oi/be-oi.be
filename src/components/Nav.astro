---
import Icon from './Icon.astro';
import { contentLocales, defaultLocale, localizePath, stripLocalePrefix } from '../data/i18n';
import { languagePickerLabels, navStrings, resolveLocale } from '../data/ui-i18n';

interface Props {
  /** Locale prefix for links, e.g. "fr". Defaults to site defaultLocale. */
  lang?: string;
}

const { lang = defaultLocale } = Astro.props;
const currentLocale = resolveLocale(lang);
const base = `/${currentLocale}`;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const pathWithoutLocale = stripLocalePrefix(Astro.url.pathname);
const t = navStrings(currentLocale);

const languageOptions = contentLocales.map((locale) => ({
  locale,
  label: languagePickerLabels[locale],
  href: localizePath(locale, pathWithoutLocale),
  current: locale === currentLocale,
}));

const mainLinks = [
  // Contest overview is the locale home (`/en/`); only exact path is active.
  { href: base, label: t.contest, match: base, exact: true },
  {
    href: `${base}/competitive-programming`,
    label: t.internationalContests,
    match: `${base}/competitive-programming`,
  },
  { href: `${base}/contest/faq`, label: t.faq, match: `${base}/contest/faq` },
  { href: `${base}/about`, label: t.about, match: `${base}/about` },
];

const labHref = `https://lab.be-oi.be/${currentLocale}/`;

function isMainActive(match: string, exact = false) {
  if (exact) return path === match;
  if (!(path === match || path.startsWith(`${match}/`))) return false;
  // Prefer a more specific main-link match (e.g. FAQ over Contest).
  return !mainLinks.some(
    (link) =>
      link.match !== match &&
      link.match.startsWith(`${match}/`) &&
      (path === link.match || path.startsWith(`${link.match}/`)),
  );
}
---
<nav class="fixed top-0 left-0 w-full z-50 bg-chrome backdrop-blur-sm border-b-2 border-on-chrome/20">
  <div class="flex justify-between items-center w-full px-margin py-sm max-w-7xl mx-auto gap-sm">
    <a href={`${base}/`} class="flex items-center gap-sm shrink-0">
      <img
        src="/img/logo-beoi-white.png"
        alt="beOI"
        class="h-10 w-10 object-contain"
        width="40"
        height="40"
      />
      <span class="font-headline text-headline-md text-on-chrome tracking-tight hidden sm:inline">beOI</span>
    </a>

    <div class="hidden md:flex items-center gap-gutter">
      {mainLinks.map((link) => (
        <a
          href={`${link.href}/`}
          class:list={[
            'font-label text-label-md transition-colors',
            isMainActive(link.match, link.exact)
              ? 'text-on-chrome border-b-2 border-on-chrome pb-1'
              : 'text-on-chrome hover:underline',
          ]}
        >
          {link.label}
        </a>
      ))}
    </div>

    <div class="flex items-center gap-sm shrink-0">
      <a
        href={labHref}
        class="nav-lab-btn inline-flex"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t.labAria}
      >
        {/* Custom Erlenmeyer flask with liquid wave (matches design mock). */}
        <svg
          class="nav-lab-btn__flask shrink-0"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          width="1.15em"
          height="1.15em"
          fill="none"
          aria-hidden="true"
        >
          <path
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M9 2.75h6M10.25 2.75v5.1L5.1 17.55A2.15 2.15 0 0 0 6.95 20.75h10.1a2.15 2.15 0 0 0 1.85-3.2L13.75 7.85v-5.1"
          />
          <path
            class="nav-lab-btn__liquid"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M7.15 15.05c1.15-.95 2.05.85 3.25-.15s2.05.85 3.2-.15 2-.75 2.85-.1"
          />
        </svg>
        <span class="hidden sm:inline">{t.lab}</span>
        <span class="sm:hidden">Lab</span>
        <Icon name="arrow_outward" class="nav-lab-btn__arrow" />
      </a>
      <div class="relative flex items-center">
        <button
          type="button"
          id="nav-lang-toggle"
          class="inline-flex items-center justify-center size-8 text-on-chrome text-2xl leading-none rounded-md hover:bg-on-chrome/15 transition-colors"
          aria-label={t.changeLanguage}
          aria-expanded="false"
          aria-controls="nav-lang-menu"
        >
          <Icon name="language" />
        </button>
        <ul
          id="nav-lang-menu"
          hidden
          class="absolute right-0 top-full mt-2 min-w-[10rem] py-1 bg-surface-container-lowest border-2 border-outline-variant/40 shadow-lg list-none m-0 p-0"
        >
          {languageOptions.map((option) => (
            <li>
              <a
                href={option.href}
                lang={option.locale}
                hreflang={option.locale}
                aria-current={option.current ? 'page' : undefined}
                class:list={[
                  'block px-4 py-2 font-label text-label-md no-underline transition-colors',
                  option.current
                    ? 'bg-primary/10 text-primary font-semibold'
                    : 'text-on-surface hover:bg-surface-container-low',
                ]}
              >
                {option.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
      <button
        type="button"
        id="nav-menu-toggle"
        class="md:hidden inline-flex items-center justify-center size-8 text-on-chrome text-2xl leading-none rounded-md hover:bg-on-chrome/15 transition-colors"
        aria-label={t.openMenu}
        data-label-open={t.openMenu}
        data-label-close={t.closeMenu}
        aria-expanded="false"
        aria-controls="nav-mobile-panel"
      >
        <span data-icon="menu" class="block">
          <Icon name="menu" />
        </span>
        <span data-icon="close" class="hidden">
          <Icon name="close" />
        </span>
      </button>
    </div>
  </div>

  <div
    id="nav-mobile-panel"
    class="md:hidden hidden border-t border-on-chrome/20 bg-chrome"
    hidden
  >
    <div class="flex flex-col max-w-7xl mx-auto px-margin py-sm">
      {mainLinks.map((link) => (
        <a
          href={`${link.href}/`}
          class:list={[
            'font-label text-label-md py-sm transition-colors',
            isMainActive(link.match, link.exact)
              ? 'text-on-chrome border-l-2 border-on-chrome pl-sm'
              : 'text-on-chrome/90 hover:text-on-chrome pl-sm border-l-2 border-transparent',
          ]}
        >
          {link.label}
        </a>
      ))}
      <div class="border-t border-on-chrome/20 mt-sm pt-sm">
        <p class="font-label text-label-md text-on-chrome/70 px-sm pb-xs">{t.changeLanguage}</p>
        <div class="flex flex-wrap gap-sm px-sm">
          {languageOptions.map((option) => (
            <a
              href={option.href}
              lang={option.locale}
              hreflang={option.locale}
              aria-current={option.current ? 'page' : undefined}
              class:list={[
                'font-label text-label-md px-3 py-1.5 border-2 no-underline transition-colors',
                option.current
                  ? 'border-on-chrome bg-on-chrome/15 text-on-chrome'
                  : 'border-on-chrome/30 text-on-chrome/90 hover:border-on-chrome hover:text-on-chrome',
              ]}
            >
              {option.label}
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</nav>

<style>
  .nav-lab-btn {
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    border: 1px solid color-mix(in srgb, var(--color-on-chrome) 30%, transparent);
    background: color-mix(in srgb, var(--color-on-chrome) 12%, transparent);
    color: var(--color-on-chrome);
    font-family: var(--font-label);
    font-size: var(--text-label-md);
    line-height: var(--text-label-md--line-height);
    letter-spacing: var(--text-label-md--letter-spacing);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .nav-lab-btn__flask {
    color: #7dffc4;
    transition: filter 0.25s ease, transform 0.25s ease;
  }

  /* Icon.astro is a child component — pierce scoped styles. */
  .nav-lab-btn :global(.nav-lab-btn__arrow) {
    font-size: 0.95em;
    opacity: 0.9;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .nav-lab-btn:hover,
  .nav-lab-btn:focus-visible {
    background: color-mix(in srgb, var(--color-on-chrome) 22%, transparent);
    border-color: color-mix(in srgb, var(--color-on-chrome) 55%, transparent);
    box-shadow: 0 0 0 1px color-mix(in srgb, #7dffc4 35%, transparent);
  }

  .nav-lab-btn:hover .nav-lab-btn__flask,
  .nav-lab-btn:focus-visible .nav-lab-btn__flask {
    filter: drop-shadow(0 0 4px color-mix(in srgb, #7dffc4 70%, transparent));
  }

  .nav-lab-btn:hover :global(.nav-lab-btn__arrow),
  .nav-lab-btn:focus-visible :global(.nav-lab-btn__arrow) {
    transform: translate(1px, -1px);
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .nav-lab-btn:hover,
    .nav-lab-btn:focus-visible {
      transform: translateY(-1px);
    }

    .nav-lab-btn:hover .nav-lab-btn__flask,
    .nav-lab-btn:focus-visible .nav-lab-btn__flask {
      transform: rotate(30deg);
    }
  }

  .nav-lab-btn:focus-visible {
    outline: 2px solid #7dffc4;
    outline-offset: 2px;
  }
</style>

<script is:inline>
  (function () {
    const langToggle = document.getElementById('nav-lang-toggle');
    const langMenu = document.getElementById('nav-lang-menu');
    const menuToggle = document.getElementById('nav-menu-toggle');
    const mobilePanel = document.getElementById('nav-mobile-panel');

    function setLangOpen(open) {
      if (!langToggle || !langMenu) return;
      langToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      langMenu.classList.toggle('hidden', !open);
      if (open) {
        langMenu.removeAttribute('hidden');
      } else {
        langMenu.setAttribute('hidden', '');
      }
    }

    function isLangOpen() {
      return langToggle?.getAttribute('aria-expanded') === 'true';
    }

    if (langToggle && langMenu) {
      langToggle.addEventListener('click', function (event) {
        event.stopPropagation();
        setLangOpen(!isLangOpen());
      });

      langMenu.addEventListener('click', function (event) {
        event.stopPropagation();
      });

      document.addEventListener('click', function () {
        if (isLangOpen()) setLangOpen(false);
      });

      document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && isLangOpen()) {
          setLangOpen(false);
          langToggle.focus();
        }
      });
    }

    if (!menuToggle || !mobilePanel) return;

    const menuIcon = menuToggle.querySelector('[data-icon="menu"]');
    const closeIcon = menuToggle.querySelector('[data-icon="close"]');
    const labelOpen = menuToggle.getAttribute('data-label-open') || 'Open menu';
    const labelClose = menuToggle.getAttribute('data-label-close') || 'Close menu';

    function setMenuOpen(open) {
      menuToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      menuToggle.setAttribute('aria-label', open ? labelClose : labelOpen);
      mobilePanel.classList.toggle('hidden', !open);
      if (open) {
        mobilePanel.removeAttribute('hidden');
      } else {
        mobilePanel.setAttribute('hidden', '');
      }
      menuIcon?.classList.toggle('hidden', open);
      menuIcon?.classList.toggle('block', !open);
      closeIcon?.classList.toggle('hidden', !open);
      closeIcon?.classList.toggle('block', open);
      document.body.classList.toggle('overflow-hidden', open);
      if (open && isLangOpen()) setLangOpen(false);
    }

    function isMenuOpen() {
      return menuToggle.getAttribute('aria-expanded') === 'true';
    }

    menuToggle.addEventListener('click', function () {
      setMenuOpen(!isMenuOpen());
    });

    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' && isMenuOpen()) {
        setMenuOpen(false);
        menuToggle.focus();
      }
    });

    const mq = window.matchMedia('(min-width: 768px)');
    function onViewportChange(event) {
      if (event.matches && isMenuOpen()) setMenuOpen(false);
    }
    if (typeof mq.addEventListener === 'function') {
      mq.addEventListener('change', onViewportChange);
    } else {
      mq.addListener(onViewportChange);
    }
  })();
</script>
