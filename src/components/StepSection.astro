---
import type { StepAccent, StepTag } from '../data/contest-steps';

interface Props {
  id: string;
  image: string;
  imageAlt: string;
  title: string;
  tagline: string;
  description: string;
  tags: StepTag[];
  detailsHtml?: string;
  accent?: StepAccent;
  reverse?: boolean;
}

const {
  id,
  image,
  imageAlt,
  title,
  tagline,
  description,
  tags,
  detailsHtml = '',
  accent = 'primary',
  reverse = false,
} = Astro.props;

const taglineClasses = {
  primary: 'text-primary',
  secondary: 'text-secondary',
  tertiary: 'text-tertiary',
  error: 'text-error',
} as const;

const tagIcons: Record<string, string> = {
  Duration: 'schedule',
  Timing: 'calendar_month',
  Location: 'location_on',
  Code: 'code',
  Format: 'tune',
  Goal: 'emoji_events',
  Rounds: 'replay',
  Focus: 'psychology',
};

function iconFor(label: string) {
  return tagIcons[label] ?? 'label';
}

const toggleId = `details-${id}`;
const hasDetails = detailsHtml.trim().length > 0;
---
<section id={id} class="group/step scroll-mt-28 py-lg border-t-2 border-outline-variant/40">
  <div
    class:list={[
      'flex flex-col lg:flex-row items-center gap-lg',
      reverse && 'lg:flex-row-reverse',
    ]}
  >
    <div class="w-full lg:w-2/5 flex justify-center">
      <div class="relative p-md bg-surface-container-low hand-drawn-border border-2 border-outline-variant stamp-shadow">
        <img
          src={image}
          alt={imageAlt}
          class="w-48 h-48 sm:w-56 sm:h-56 object-contain"
          style="image-rendering: pixelated;"
          width="224"
          height="224"
        />
      </div>
    </div>

    <div class="w-full lg:w-3/5">
      <h2 class="font-headline text-headline-lg text-on-surface mb-xs">{title}</h2>
      <p class:list={['font-bold mb-md', taglineClasses[accent]]}>{tagline}</p>
      <p class="text-body-lg font-body text-on-surface-variant mb-md max-w-2xl">
        {description}
      </p>
      <div class="flex flex-wrap gap-sm mb-md">
        {tags.map((tag) => (
          <span
            class="inline-flex items-center gap-xs px-3 py-1.5 rounded-full border border-outline-variant bg-surface-container-lowest text-on-surface-variant"
            title={tag.label}
          >
            <span
              class="material-symbols-outlined text-primary text-[1.125rem] leading-none"
              aria-hidden="true"
            >
              {iconFor(tag.label)}
            </span>
            <span class="sr-only">{tag.label}: </span>
            <span class="font-body text-sm leading-none text-on-surface">{tag.value}</span>
          </span>
        ))}
      </div>

      {hasDetails && (
        <label
          for={toggleId}
          class="inline-flex items-center gap-xs cursor-pointer font-label text-label-md text-primary border-2 border-primary/30 bg-primary/5 hover:bg-primary/10 px-4 py-2 rounded-full transition-colors select-none"
        >
          <input id={toggleId} type="checkbox" class="peer sr-only" />
          <span class="inline-flex items-center gap-xs peer-checked:hidden">
            Show more details
            <span class="material-symbols-outlined text-[1.125rem] leading-none" aria-hidden="true">
              expand_more
            </span>
          </span>
          <span class="hidden items-center gap-xs peer-checked:inline-flex">
            Hide details
            <span class="material-symbols-outlined text-[1.125rem] leading-none" aria-hidden="true">
              expand_less
            </span>
          </span>
        </label>
      )}
    </div>
  </div>

  {hasDetails && (
    <div class="step-details-html hidden group-has-[input:checked]/step:block w-full mt-lg pt-md border-t border-outline-variant/50">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-md lg:gap-lg" set:html={detailsHtml} />
    </div>
  )}
</section>

<style>
  .step-details-html :global(section) {
    margin: 0;
  }

  .step-details-html :global(h3) {
    font-family: var(--font-headline);
    font-size: var(--text-headline-md);
    line-height: var(--text-headline-md--line-height);
    font-weight: 700;
    color: var(--color-on-surface);
    margin: 0 0 0.25rem;
  }

  .step-details-html :global(p) {
    font-family: var(--font-body);
    font-size: var(--text-body-md);
    line-height: 1.6;
    color: var(--color-on-surface-variant);
    margin: 0;
  }

  .step-details-html :global(p + p) {
    margin-top: 0.5rem;
  }

  .step-details-html :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .step-details-html :global(a:hover) {
    text-decoration-thickness: 2px;
  }
</style>
