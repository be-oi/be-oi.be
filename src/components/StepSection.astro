---
interface Tag {
  label: string;
  value: string;
}

interface Props {
  id: string;
  image: string;
  imageAlt: string;
  title: string;
  tagline: string;
  description: string;
  tags: Tag[];
  accent?: 'primary' | 'secondary' | 'tertiary' | 'error';
  reverse?: boolean;
}

const {
  id,
  image,
  imageAlt,
  title,
  tagline,
  description,
  tags,
  accent = 'primary',
  reverse = false,
} = Astro.props;

const taglineClasses = {
  primary: 'text-primary',
  secondary: 'text-secondary',
  tertiary: 'text-tertiary',
  error: 'text-error',
} as const;
---
<section id={id} class="scroll-mt-28 py-lg border-t-2 border-outline-variant/40">
  <div
    class:list={[
      'flex flex-col lg:flex-row items-center gap-lg',
      reverse && 'lg:flex-row-reverse',
    ]}
  >
    <div class="w-full lg:w-2/5 flex justify-center">
      <div class="relative p-md bg-surface-container-low hand-drawn-border border-2 border-outline-variant stamp-shadow">
        <img
          src={image}
          alt={imageAlt}
          class="w-48 h-48 sm:w-56 sm:h-56 object-contain"
          style="image-rendering: pixelated;"
          width="224"
          height="224"
        />
      </div>
    </div>

    <div class="w-full lg:w-3/5">
      <h2 class="font-headline text-headline-lg text-on-surface mb-xs">{title}</h2>
      <p class:list={['font-bold mb-md', taglineClasses[accent]]}>{tagline}</p>
      <p class="text-body-lg font-body text-on-surface-variant mb-md max-w-2xl">
        {description}
      </p>
      <div class="flex flex-wrap gap-sm">
        {tags.map((tag) => (
          <span class="inline-flex items-baseline gap-xs px-3 py-1.5 rounded-full border border-outline-variant bg-surface-container-lowest text-on-surface-variant">
            <span class="font-label text-label-md leading-none text-primary uppercase tracking-wide">{tag.label}</span>
            <span class="font-body text-sm leading-none text-on-surface">{tag.value}</span>
          </span>
        ))}
      </div>
    </div>
  </div>
</section>
