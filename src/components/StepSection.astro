---
import Icon from './Icon.astro';
import type { StepAccent, StepTag, StepTagKind } from '../data/contest-steps';
import type { StepImage } from '../data/contest-steps/images';
import { defaultLocale } from '../data/i18n';
import { stepSectionStrings } from '../data/ui-i18n';
import type { ComponentProps } from 'astro/types';

type IconName = ComponentProps<typeof Icon>['name'];

interface Props {
  id: string;
  image: StepImage;
  imageAlt: string;
  title: string;
  tagline: string;
  description: string;
  tags: StepTag[];
  detailsHtml?: string;
  accent?: StepAccent;
  reverse?: boolean;
  /** Locale for expandable panel labels. Defaults to site defaultLocale. */
  lang?: string;
}

const {
  id,
  image,
  imageAlt,
  title,
  tagline,
  description,
  tags,
  detailsHtml = '',
  accent = 'primary',
  reverse = false,
  lang = defaultLocale,
} = Astro.props;

const stepLabels = stepSectionStrings(lang);

const taglineClasses = {
  primary: 'text-primary',
  secondary: 'text-secondary',
  tertiary: 'text-tertiary',
} as const;

const tagIcons: Record<StepTagKind, IconName | null> = {
  duration: 'schedule',
  timing: 'calendar_month',
  location: 'location_on',
  code: 'code',
  status: null,
};

const hasDetails = detailsHtml.trim().length > 0;
---
<section
  id={id}
  class:list={[
    'step-section scroll-mt-36 py-lg border-t-2 border-outline-variant/40',
    reverse && 'step-section-reverse',
  ]}
>
  <div class="step-image flex justify-center">
    <img
      src={image.src}
      alt={imageAlt}
      width={image.width}
      height={image.height}
      class="w-64 h-64 sm:w-72 sm:h-72 lg:w-80 lg:h-80 object-contain"
      loading="lazy"
      decoding="async"
    />
  </div>

  <div class="step-body">
    <h2 class="font-headline text-headline-lg text-on-surface mb-xs">{title}</h2>
    <p class:list={['font-bold mb-md', taglineClasses[accent]]}>{tagline}</p>
    <p class="text-body-lg font-body text-on-surface-variant mb-md max-w-2xl">
      {description}
    </p>
    <div class:list={['flex flex-wrap gap-sm', hasDetails && 'mb-md']}>
      {tags.map((tag) => {
        const icon = tagIcons[tag.kind];
        return (
          <span
            class="inline-flex items-center gap-xs px-3 py-1.5 rounded-full border border-outline-variant bg-surface-container-lowest text-on-surface-variant"
            title={tag.label}
          >
            {icon && <Icon name={icon} class="text-primary text-[1.125rem]" />}
            <span class="sr-only">{tag.label}: </span>
            <span class="font-body text-sm leading-none text-on-surface">{tag.value}</span>
          </span>
        );
      })}
    </div>

    {hasDetails && (
      <details class="step-details">
        <summary class="step-details-summary inline-flex items-center gap-xs cursor-pointer font-label text-label-md text-primary border-2 border-primary/30 bg-primary/5 hover:bg-primary/10 px-4 py-2 rounded-full transition-colors select-none">
          <span class="step-details-label-closed inline-flex items-center gap-xs">
            {stepLabels.showMore}
            <Icon name="expand_more" class="text-[1.125rem]" />
          </span>
          <span class="step-details-label-open items-center gap-xs">
            {stepLabels.hideDetails}
            <Icon name="expand_less" class="text-[1.125rem]" />
          </span>
        </summary>
        <div class="step-details-html mt-lg pt-md border-t border-outline-variant/50">
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-md lg:gap-lg" set:html={detailsHtml} />
        </div>
      </details>
    )}
  </div>
</section>

<style>
  .step-section {
    container-type: inline-size;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-lg);
    align-items: start;
  }

  .step-image,
  .step-body {
    min-width: 0;
  }

  @media (min-width: 1024px) {
    .step-section {
      grid-template-columns: 2fr 3fr;
    }

    .step-section-reverse {
      grid-template-columns: 3fr 2fr;
    }

    .step-image {
      grid-column: 1;
      grid-row: 1;
    }

    .step-body {
      grid-column: 2;
      grid-row: 1;
    }

    .step-section-reverse .step-image {
      grid-column: 2;
    }

    .step-section-reverse .step-body {
      grid-column: 1;
    }

    /* Break the details panel out to the full section width (both columns). */
    .step-details-html {
      width: 100cqi;
      max-width: 100cqi;
      box-sizing: border-box;
    }

    /* Body is the right column: shift panel back to the section’s left edge. */
    .step-section:not(.step-section-reverse) .step-details-html {
      margin-left: calc(100% - 100cqi);
    }
  }

  /* Closed panels stay out of layout so Astro’s dev audit does not treat
     hidden headings/links as missing accessible names (innerText is empty). */
  .step-details:not([open]) .step-details-html {
    display: none;
  }

  .step-details-summary {
    list-style: none;
  }

  .step-details-summary::-webkit-details-marker {
    display: none;
  }

  /* Only the active label stays in the accessibility tree (display: none). */
  .step-details-label-open {
    display: none;
  }

  .step-details[open] > .step-details-summary .step-details-label-closed {
    display: none;
  }

  .step-details[open] > .step-details-summary .step-details-label-open {
    display: inline-flex;
  }

  .step-details-html :global(section) {
    margin: 0;
  }

  .step-details-html :global(h3) {
    font-family: var(--font-headline);
    font-size: var(--text-headline-md);
    line-height: var(--text-headline-md--line-height);
    font-weight: 700;
    color: var(--color-on-surface);
    margin: 0 0 0.25rem;
  }

  .step-details-html :global(p) {
    font-family: var(--font-body);
    font-size: var(--text-body-md);
    line-height: 1.6;
    color: var(--color-on-surface-variant);
    margin: 0;
  }

  .step-details-html :global(p + p) {
    margin-top: 0.5rem;
  }

  .step-details-html :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .step-details-html :global(a:hover) {
    text-decoration-thickness: 2px;
  }
</style>
