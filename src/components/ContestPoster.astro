---
import { Image } from 'astro:assets';
import { resolveLocale } from '../data/ui-i18n';
import { contestPoster } from '../data/posters';

interface Props {
  lang: string;
  /** Accessible name for the download link (also used as image link label). */
  label: string;
  /** Primary CTA text under the preview. */
  cta: string;
  /** Short meta line under the CTA (format / year). */
  caption: string;
  /** Set when the poster is above the fold. */
  eager?: boolean;
}

const { lang, label, cta, caption, eager = false } = Astro.props;
const poster = contestPoster(resolveLocale(lang));
const hasSecondary = Astro.slots.has('secondary');
---
<div class="contest-poster inline-flex flex-col items-center gap-md">
  <a
    href={poster.href}
    target="_blank"
    rel="noopener noreferrer"
    class="contest-poster__frame group relative block wobbly-rotation-1 stamp-shadow bg-surface-container-lowest border-2 border-outline-variant/50 overflow-hidden no-underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary motion-safe:transition-transform motion-safe:duration-300 motion-safe:hover:-translate-y-1.5 motion-safe:hover:rotate-0"
    aria-label={label}
  >
    <Image
      src={poster.image}
      alt=""
      width={360}
      densities={[1, 2]}
      class="block w-56 sm:w-72 md:w-80 h-auto"
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
    />
    <span
      class="absolute bottom-3 right-3 font-label text-xs tracking-wide uppercase px-2.5 py-1 rounded bg-primary text-on-primary"
      aria-hidden="true"
    >
      PDF
    </span>
  </a>
  <div
    class:list={[
      'flex flex-wrap justify-center gap-sm',
      hasSecondary ? 'items-center' : '',
    ]}
  >
    <a
      href={poster.href}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center min-h-11 font-label text-label-md tracking-wide px-6 py-2.5 rounded-full bg-primary text-on-primary border-2 border-primary no-underline motion-safe:transition-colors hover:bg-primary/90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
    >
      {cta}
    </a>
    <slot name="secondary" />
  </div>
  <span class="font-label text-sm text-on-surface-variant">
    {caption}
  </span>
</div>
