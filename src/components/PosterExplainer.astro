<script>
  function openDangerZoneForHash() {
    const zone = document.getElementById('deep-dive');
    if (!(zone instanceof HTMLDetailsElement)) return;
    const hash = window.location.hash.slice(1);
    if (!hash) return;
    const target = document.getElementById(hash);
    if (target && zone.contains(target)) {
      zone.open = true;
    }
  }

  openDangerZoneForHash();
  window.addEventListener('hashchange', openDangerZoneForHash);
</script>
