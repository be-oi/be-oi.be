---
import { Image } from 'astro:assets';
import type { ContestStep } from '../data/contest-steps/types';

interface Props {
  steps: ContestStep[];
  ariaLabel: string;
}

const { steps, ariaLabel } = Astro.props;

/**
 * How many timeline sprites to load eagerly.
 * Matches ~3 equal columns visible before horizontal scroll on narrow phones
 * (minmax(5.5rem,1fr) tracks). Later steps stay lazy until scrolled into view;
 * on wide viewports the browser still loads in-viewport lazy images, but they
 * no longer race the critical path as six parallel eagers.
 */
const TIMELINE_EAGER_COUNT = 3;
---
<section aria-label={ariaLabel} class="relative mb-xl max-w-[940px] mx-auto w-full">
  <!--
    Explicit equal columns for every step; fixed tracks for the gaps
    (after start, after qualif, after final). Subgrid keeps label tops aligned.
    Each sprite sits in a uniform aspect-square canvas with %-based placement
    so vertical alignment scales with the viewport.
    minmax(5.5rem, 1fr) keeps each step column usable on narrow phones (~600px
    min track total) so small viewports can still scroll; md+ uses overflow-x-visible
    so canvasWidth over 100% (e.g. last icon) can stick out without a scrollbar.
  -->
  <div
    class="grid overflow-x-auto md:overflow-x-visible pb-md snap-x snap-mandatory"
    style="grid-template-columns: minmax(5.5rem,1fr) 1.5rem minmax(5.5rem,1fr) 1.5rem minmax(5.5rem,1fr) minmax(5.5rem,1fr) minmax(5.5rem,1fr) 1.5rem minmax(5.5rem,1fr); grid-template-rows: auto auto auto;"
  >
    {steps.map((step, index) => {
      const eager = index < TIMELINE_EAGER_COUNT;
      return (
        <a
          href={`#${step.id}`}
          class="grid grid-rows-subgrid justify-items-center text-center snap-center min-w-0 motion-safe:transition-transform motion-safe:hover:-translate-y-1"
          style={`grid-column: ${step.gridColumn}; grid-row: 1 / span 3;`}
        >
          <div class="relative w-full aspect-[10/13] overflow-visible">
            <div
              class="absolute left-1/2 -translate-x-1/2"
              style={`top: ${step.canvasTop}; width: ${step.canvasWidth}; aspect-ratio: ${step.image.width} / ${step.image.height};`}
            >
              <Image
                src={step.image}
                alt=""
                class="w-full h-full object-contain"
                loading={eager ? 'eager' : 'lazy'}
                decoding="async"
                fetchpriority="low"
              />
            </div>
          </div>
          <span class="font-label text-label-md text-on-surface -mt-1 w-full min-w-0 max-w-full break-words text-center self-start justify-self-stretch">
            {step.shortTitle}
          </span>
          <p class="text-xs text-on-surface-variant mt-0 leading-snug text-center w-full min-w-0 max-w-full break-words self-start justify-self-stretch">
            {step.teaser.map((line, lineIndex) => (
              <>
                {lineIndex > 0 && <br />}
                {line}
              </>
            ))}
          </p>
        </a>
      );
    })}
  </div>
</section>
