---
import { mailingListStrings } from '../data/ui-i18n';

interface Props {
  lang: string;
  /**
   * Base id for the section, form, and status messages.
   * Must be unique if more than one form is rendered on the same page.
   */
  id?: string;
}

const { lang, id: idBase = 'newsletter' } = Astro.props;
const t = mailingListStrings(lang);
const formId = `${idBase}-form`;
const emailId = `${idBase}-email`;
const alreadyId = `${idBase}-already`;
const successId = `${idBase}-success`;
const failureId = `${idBase}-failure`;
const actionUrl = 'https://bvduaeykw6ah6ni7xoykyi3wt40ntdrx.lambda-url.eu-central-1.on.aws/';
---

<section
  id={idBase}
  data-mailing-list
  aria-label={t.sectionAria}
  class="mb-xl max-w-2xl mx-auto text-center scroll-mt-28"
>
  <h2 class="font-headline text-headline-md text-on-surface mb-sm">
    {t.heading}
  </h2>
  <p class="font-body text-body-md text-on-surface-variant mb-md">
    {t.intro}
  </p>

  <form
    id={formId}
    action={actionUrl}
    method="post"
    class="flex flex-col sm:flex-row gap-sm items-stretch sm:items-center justify-center"
  >
    <label for={emailId} class="sr-only">{t.emailLabel}</label>
    <input
      id={emailId}
      type="email"
      name="email"
      required
      autocomplete="email"
      placeholder={t.emailPlaceholder}
      class="flex-1 min-w-0 px-4 py-2.5 rounded-full border-2 border-outline-variant/60 bg-surface-container-lowest font-body text-body-md text-on-surface placeholder:text-on-surface-variant/60 focus:outline-none focus:border-primary"
    />
    <input type="hidden" name="lang" value={lang} />
    <div class="absolute left-[-5000px]" aria-hidden="true">
      <input type="text" name="nottobefilled" tabindex="-1" value="" autocomplete="off" />
    </div>
    <button
      type="submit"
      class="shrink-0 font-label text-label-md text-on-primary bg-primary hover:bg-primary/90 px-5 py-2.5 rounded-full border-2 border-primary transition-colors disabled:opacity-60 disabled:cursor-not-allowed"
    >
      {t.submit}
    </button>
  </form>

  <div class="mt-md space-y-xs font-body text-body-md font-medium" aria-live="polite">
    <p id={alreadyId} data-ml-status="already" class="hidden text-tertiary">
      {t.already}
    </p>
    <p id={successId} data-ml-status="success" class="hidden text-secondary">
      {t.success}
    </p>
    <p id={failureId} data-ml-status="failure" class="hidden text-error">
      {t.failure}
    </p>
  </div>
</section>

<script is:inline>
  (function () {
    document.querySelectorAll('[data-mailing-list]').forEach(function (root) {
      if (root.getAttribute('data-ml-bound') === '1') return;
      root.setAttribute('data-ml-bound', '1');

      var form = root.querySelector('form');
      if (!form) return;

      var already = root.querySelector('[data-ml-status="already"]');
      var success = root.querySelector('[data-ml-status="success"]');
      var failure = root.querySelector('[data-ml-status="failure"]');
      var button = form.querySelector('button[type="submit"]');

      function hideAlerts() {
        already.classList.add('hidden');
        success.classList.add('hidden');
        failure.classList.add('hidden');
      }

      function show(el) {
        el.classList.remove('hidden');
      }

      // Listmonk/Lambda: 409 Conflict and messages mentioning already exists/subscribed.
      function isAlreadySubscribed(status, response) {
        if (status === 409) return true;
        var message = response && response.message;
        if (typeof message !== 'string') return false;
        return /already\s*(exists|subscribed)/i.test(message);
      }

      form.addEventListener('submit', function (event) {
        event.preventDefault();
        hideAlerts();

        if (button) button.disabled = true;

        var body = new URLSearchParams(new FormData(form));

        fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: body.toString(),
        })
          .then(function (res) {
            return res.json().then(
              function (response) {
                return { res: res, response: response };
              },
              function () {
                return { res: res, response: null };
              },
            );
          })
          .then(function (result) {
            var res = result.res;
            var response = result.response;

            if (isAlreadySubscribed(res.status, response)) {
              show(already);
              return;
            }
            if (res.ok && response && response.data) {
              show(success);
              return;
            }
            show(failure);
          })
          .catch(function () {
            show(failure);
          })
          .finally(function () {
            if (button) button.disabled = false;
          });
      });
    });
  })();
</script>
