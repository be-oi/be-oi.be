---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import ContestTimeline from '../../components/ContestTimeline.astro';
import StepSection from '../../components/StepSection.astro';
import MailingListForm from '../../components/MailingListForm.astro';
import { getContestSteps } from '../../data/contest-steps';

const contestSteps = getContestSteps('de');
---
<BaseLayout
  title="beOI 2027 – Eine neue Wettbewerbsstruktur"
  description="Die Belgische Informatik-Olympiade ist ein Wettbewerb im computationalen Denken und eine Einführung ins Programmieren für Schülerinnen und Schüler der Primar- und Sekundarschule. Ab 2027 verändert sie sich: fünf Phasen begleiten Teilnehmende von 10 bis 18 Jahren, von Logikrätseln bis zur Vertretung Belgiens bei internationalen Programmierwettbewerben."
  lang="de"
>
  <Nav lang="de" />

  <main id="main" class="pt-32 pb-0 overflow-x-clip">
    <div class="px-margin max-w-7xl mx-auto">
      <!-- Hero -->
      <section class="text-center mb-xl">
        <div class="inline-block px-4 py-1 bg-tertiary-container/20 text-tertiary rounded-full font-label text-label-md mb-md wobbly-rotation-1 border border-tertiary/20">
          Neu in 2027
        </div>
        <h1 class="font-headline text-headline-xl text-on-surface mb-md">
          Eine neue Wettbewerbsstruktur<br />
          <span class="text-primary relative inline-block">
            Von spaßiger Logik zum Wettbewerbprogrammieren
            <span class="absolute -bottom-2 left-0 w-full h-1 bg-primary/20 rounded-full"></span>
          </span>
        </h1>
        <p class="text-body-lg font-body text-on-surface-variant max-w-2xl mx-auto text-pretty">
          Die Belgische Informatik-Olympiade ist ein Wettbewerb im computationalen Denken und eine Einführung&nbsp;ins&nbsp;Programmieren für Schülerinnen und Schüler der Primar- und Sekundarschule.<br />
          Ab 2027 verändert sie sich: fünf Phasen begleiten Teilnehmende von 10 bis 18 Jahren, von Logikrätseln bis zur Vertretung Belgiens bei internationalen Programmierwettbewerben.
        </p>
      </section>

      <ContestTimeline steps={contestSteps} ariaLabel="Zeitachse des Wettbewerbsverlaufs" />

      <MailingListForm lang="de" />
    </div>

    <!-- Full-bleed step sections: alternate white / craft-paper -->
    <div class="flex flex-col">
      {contestSteps.map((step, i) => (
        <StepSection
          id={step.id}
          image={step.image}
          imageAlt={step.imageAlt}
          title={step.title}
          tagline={step.tagline}
          description={step.description}
          tags={step.tags}
          detailsHtml={step.detailsHtml}
          cta={step.cta}
          accent={step.accent}
          reverse={i % 2 === 1}
          whiteBand={i % 2 === 0}
          lang="de"
        />
      ))}
    </div>
  </main>
  <Footer lang="de" />
</BaseLayout>
