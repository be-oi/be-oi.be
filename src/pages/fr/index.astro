---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import ContestTimeline from '../../components/ContestTimeline.astro';
import StepSection from '../../components/StepSection.astro';
import MailingListForm from '../../components/MailingListForm.astro';
import { getContestSteps } from '../../data/contest-steps';

const contestSteps = getContestSteps('fr');
---
<BaseLayout
  title="beOI 2027 – Une nouvelle structure de concours"
  description="L’Olympiade belge d’Informatique est un concours de raisonnement informatique et d’initiation à la programmation pour élèves du primaire et du secondaire. À partir de 2027, elle se métamorphose&nbsp;: cinq étapes accompagnent les participants de 10 à 18 ans, des énigmes de logique jusqu’à la représentation de la Belgique lors de concours internationaux de programmation."
  lang="fr"
>
  <Nav lang="fr" />

  <main id="main" class="pt-32 pb-0 overflow-x-clip">
    <div class="px-margin max-w-7xl mx-auto">
      <section class="text-center mb-xl">
        <div class="inline-block px-4 py-1 bg-tertiary-container/20 text-tertiary rounded-full font-label text-label-md mb-md wobbly-rotation-1 border border-tertiary/20">
          Nouveau en 2027
        </div>
        <h1 class="font-headline text-headline-xl text-on-surface mb-md">
          Une nouvelle structure de concours<br />
          <span class="text-primary relative inline-block">
            Des énigmes de logique à la programmation compétitive
            <span class="absolute -bottom-2 left-0 w-full h-1 bg-primary/20 rounded-full"></span>
          </span>
        </h1>
        <p class="text-body-lg font-body text-on-surface-variant max-w-2xl mx-auto text-pretty">
          L’Olympiade belge d’Informatique est un concours de raisonnement informatique et d’initiation à la programmation pour élèves du primaire et&nbsp;du&nbsp;secondaire.<br />
          À partir de 2027, elle se métamorphose&nbsp;: cinq étapes accompagnent les participants de 10 à 18 ans, des énigmes de logique jusqu’à la représentation de la Belgique lors de concours internationaux de programmation.
        </p>
      </section>

      <ContestTimeline steps={contestSteps} ariaLabel="Frise chronologique du parcours du concours" />

      <MailingListForm lang="fr" />
    </div>

    <div class="flex flex-col">
      {contestSteps.map((step, i) => (
        <StepSection
          id={step.id}
          image={step.image}
          imageAlt={step.imageAlt}
          title={step.title}
          tagline={step.tagline}
          description={step.description}
          tags={step.tags}
          detailsHtml={step.detailsHtml}
          cta={step.cta}
          accent={step.accent}
          reverse={i % 2 === 1}
          whiteBand={i % 2 === 0}
          lang="fr"
        />
      ))}
    </div>
  </main>
  <Footer lang="fr" />
</BaseLayout>
