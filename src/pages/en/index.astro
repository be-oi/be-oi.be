---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import StepSection from '../../components/StepSection.astro';

const steps = [
  {
    id: 'step-initial',
    image: '/img/steps/step0-initial.png',
    imageAlt: 'Pixel-art adventurer at a campsite with a cat, backpack, and wooden sword',
    level: 'Level 0',
    title: 'Initial / Logic round',
    shortTitle: 'Logic',
    tagline: 'Just for fun',
    description:
      'A light-hearted introduction to logical reasoning. No programming required — just brain power! Perfect for younger students and anyone curious about problem-solving.',
    tags: [
      { label: 'Duration', value: '~45 min' },
      { label: 'Timing', value: 'Oct – Nov' },
      { label: 'Format', value: 'Online / school' },
      { label: 'Code', value: 'Not required' },
    ],
    accent: 'primary' as const,
    wobble: 'wobbly-rotation-1',
  },
  {
    id: 'step-qualif',
    image: '/img/steps/step1-qualif.png',
    imageAlt: 'Pixel-art adventurer progressing along a grassy path with signposts',
    level: 'Level 1',
    title: 'Qualification',
    shortTitle: 'Qualification',
    tagline: 'Find the problem-solvers',
    description:
      'Short online contests that identify strong problem-solvers across Belgium. Multiple rounds give everyone a fair chance to qualify for the next stages.',
    tags: [
      { label: 'Duration', value: '40 min each' },
      { label: 'Timing', value: 'Dec – Feb' },
      { label: 'Format', value: 'Online' },
      { label: 'Rounds', value: 'Several' },
    ],
    accent: 'secondary' as const,
    wobble: 'wobbly-rotation-2',
  },
  {
    id: 'step-quarter',
    image: '/img/steps/step2-quarter.png',
    imageAlt: 'Pixel-art adventurer with pith helmet exploring a rocky clearing',
    level: 'Level 2',
    title: 'Quarter-final',
    shortTitle: 'Quarter-final',
    tagline: 'Skills check',
    description:
      'A longer contest focused on fundamental programming skills and algorithmic thinking. This is where coding really starts to matter.',
    tags: [
      { label: 'Duration', value: '~2 hours' },
      { label: 'Timing', value: 'March' },
      { label: 'Format', value: 'Online' },
      { label: 'Focus', value: 'Fundamentals' },
    ],
    accent: 'secondary' as const,
    wobble: 'wobbly-rotation-1',
  },
  {
    id: 'step-semi',
    image: '/img/steps/step3-semi.png',
    imageAlt: 'Pixel-art armored knight with sword on a rocky island',
    level: 'Level 3',
    title: 'Semi-final',
    shortTitle: 'Semi-final',
    tagline: 'Regional centers',
    description:
      'An in-person contest at regional centers across Belgium. Advanced problems test data structures, algorithms, and careful implementation under time pressure.',
    tags: [
      { label: 'Duration', value: '~3 hours' },
      { label: 'Timing', value: 'April' },
      { label: 'Format', value: 'On-site' },
      { label: 'Location', value: 'Regional centers' },
    ],
    accent: 'tertiary' as const,
    wobble: 'wobbly-rotation-2',
  },
  {
    id: 'step-final',
    image: '/img/steps/step4-final.png',
    imageAlt: 'Pixel-art knight with glowing sword on a volcanic lava island',
    level: 'Level 4',
    title: 'Final',
    shortTitle: 'Final',
    tagline: 'The culmination',
    description:
      'The ultimate national contest with mid-level to very hard problems. The best young informaticians in Belgium compete for the national titles.',
    tags: [
      { label: 'Duration', value: '~4–5 hours' },
      { label: 'Timing', value: 'May' },
      { label: 'Format', value: 'On-site' },
      { label: 'Location', value: 'National venue' },
    ],
    accent: 'tertiary' as const,
    wobble: 'wobbly-rotation-1',
  },
  {
    id: 'step-intern',
    image: '/img/steps/step5-intern.png',
    imageAlt: 'Pixel-art rocket launching from Earth toward international contests',
    level: 'Ultimate',
    title: 'International selection',
    shortTitle: 'International',
    tagline: 'World stage',
    description:
      'Top contestants are invited to training camps and selected to represent Belgium at international olympiads such as IOI and EGOI.',
    tags: [
      { label: 'Duration', value: 'Training camps' },
      { label: 'Timing', value: 'Summer' },
      { label: 'Format', value: 'Selection + camps' },
      { label: 'Goal', value: 'IOI / EGOI' },
    ],
    accent: 'error' as const,
    wobble: 'wobbly-rotation-3',
  },
];
---
<BaseLayout title="beOI 2027 – A new contest structure" lang="en">
  <Nav activeHref="#contest" />

  <main class="pt-32 pb-xl px-margin max-w-7xl mx-auto">
    <!-- Hero -->
    <section id="contest" class="text-center mb-xl scroll-mt-28">
      <div class="inline-block px-4 py-1 bg-tertiary-container/20 text-tertiary rounded-full font-label text-label-md mb-md wobbly-rotation-1 border border-tertiary/20">
        New in 2027
      </div>
      <h1 class="font-headline text-headline-xl text-on-surface mb-md">
        A new contest structure<br />
        <span class="text-primary relative inline-block">
          From fun logic to competitive programming
          <span class="absolute -bottom-2 left-0 w-full h-1 bg-primary/20 rounded-full"></span>
        </span>
      </h1>
      <p class="text-body-lg font-body text-on-surface-variant max-w-2xl mx-auto">
        Starting in 2027, the Belgian Olympiad in Informatics takes a clearer shape.
        Six stages take you — from age 10 to 18 — from playful logic puzzles all the way to representing Belgium internationally.
        <br /><br />
        Explore the path below — details for each stage follow.
      </p>
    </section>

    <!-- Horizontal timeline -->
    <section aria-label="Contest journey timeline" class="relative mb-xl">
      <div class="flex overflow-x-auto pb-md snap-x snap-mandatory lg:overflow-visible">
        {steps.map((step, i) => {
          // Horizontal gaps after start→1, 1→2, and 4→5
          const gapAfter = i === 0 || i === 1 || i === 4;
          // Vertical offsets (px): step2 up 6, step3 up 27, step4 down 22
          const yOffset = [0, 0, -6, -25, 22, 0][i];

          return (
            <a
              href={`#${step.id}`}
              class="group snap-center shrink-0 w-36 lg:w-0 lg:flex-1 flex flex-col items-center text-center transition-transform hover:-translate-y-1"
              style={gapAfter ? 'margin-right: 1.5rem;' : undefined}
            >
              <div
                class="flex flex-col items-center w-full"
                style={`transform: translateY(${yOffset}px);`}
              >
                <img
                  src={step.image}
                  alt=""
                  class="w-full h-auto object-contain"
                  style={`image-rendering: pixelated;${i === 5 ? ' transform: scale(0.8);' : ''}`}
                  width="160"
                  height="160"
                />
                <span
                  class:list={[
                    'font-label text-label-md text-on-surface mt-sm',
                    step.wobble,
                  ]}
                >
                  {step.shortTitle}
                </span>
                <span class="text-xs text-on-surface-variant mt-xs opacity-70">
                  {i === 0 ? 'Start' : `Step ${i}`}
                </span>
              </div>
            </a>
          );
        })}
      </div>
    </section>

    <!-- Full-width step sections -->
    <div class="flex flex-col">
      {steps.map((step, i) => (
        <StepSection
          id={step.id}
          image={step.image}
          imageAlt={step.imageAlt}
          level={step.level}
          title={step.title}
          tagline={step.tagline}
          description={step.description}
          tags={step.tags}
          accent={step.accent}
          reverse={i % 2 === 1}
        />
      ))}
    </div>
  </main>

  <Footer />
</BaseLayout>
