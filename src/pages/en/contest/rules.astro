---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
---
<BaseLayout
  title="Rules – The beOI Contest"
  description="Official contest rules for the Belgian Olympiad in Informatics: who can take part, how rounds work, and what is allowed."
  lang="en"
>
  <Nav lang="en" />

  <main class="pt-32 pb-xl px-margin max-w-7xl mx-auto">
    <section class="max-w-2xl">
      <h1 class="font-headline text-headline-xl text-on-surface mb-md">Rules</h1>
      <p class="text-body-lg font-body text-on-surface-variant">
        Contest rules for the Belgian Olympiad in Informatics will appear here.
      </p>
    </section>
  </main>
  <Footer />
</BaseLayout>
