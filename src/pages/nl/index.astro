---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import ContestTimeline from '../../components/ContestTimeline.astro';
import StepSection from '../../components/StepSection.astro';
import ContestPoster from '../../components/ContestPoster.astro';
import MailingListForm from '../../components/MailingListForm.astro';
import { getContestSteps } from '../../data/contest-steps';

const contestSteps = getContestSteps('nl');
---
<BaseLayout
  title="beOI 2027 – Een nieuwe wedstrijdstructuur"
  description="De Belgische Informatica-olympiade is een wedstrijd in computationeel redeneren en een kennismaking met programmeren voor leerlingen uit het lager en secundair onderwijs. Vanaf 2026-2027 ondergaat ze een metamorfose: vijf fases begeleiden deelnemers van 10 tot 18 jaar, van logica-raadsels tot België vertegenwoordigen op internationale programmeerwedstrijden."
  lang="nl"
>
  <Nav lang="nl" />

  <main id="main" class="pt-32 pb-0 overflow-x-clip">
    <div class="px-margin max-w-7xl mx-auto">
      <!-- Hero -->
      <section class="text-center mb-xl">
        <div class="inline-block px-4 py-1 bg-tertiary-container/20 text-tertiary rounded-full font-label text-label-md mb-md wobbly-rotation-1 border border-tertiary/20">
          Nieuw in 2026-2027
        </div>
        <h1 class="font-headline text-headline-xl text-on-surface mb-md">
          Een nieuwe wedstrijdstructuur<br />
          <span class="text-primary relative inline-block">
            Van leuke logica tot competitive programming
            <span class="absolute -bottom-2 left-0 w-full h-1 bg-primary/20 rounded-full"></span>
          </span>
        </h1>
        <p class="text-body-lg font-body text-on-surface-variant max-w-2xl mx-auto text-pretty">
          De Belgische Informatica-olympiade is een wedstrijd in computationeel redeneren en een kennismaking met programmeren voor leerlingen uit het lager en secundair onderwijs.<br />
          Vanaf 2026-2027 ondergaat ze een metamorfose: vijf fases begeleiden deelnemers van 10 tot 18 jaar, van logica-raadsels tot België vertegenwoordigen op internationale programmeerwedstrijden.
        </p>
      </section>

      <ContestTimeline steps={contestSteps} ariaLabel="Tijdlijn van het wedstrijdtraject" />

      <MailingListForm lang="nl" />
    </div>

    <!-- Full-bleed step sections: alternate white / craft-paper -->
    <div class="flex flex-col">
      {contestSteps.map((step, i) => (
        <StepSection
          id={step.id}
          image={step.image}
          imageAlt={step.imageAlt}
          title={step.title}
          tagline={step.tagline}
          description={step.description}
          tags={step.tags}
          detailsHtml={step.detailsHtml}
          cta={step.cta}
          accent={step.accent}
          reverse={i % 2 === 1}
          whiteBand={i % 2 === 0}
          lang="nl"
        />
      ))}
    </div>

    <section
      id="poster"
      class="scroll-mt-28 relative bg-surface-container-lowest border-y-2 border-outline-variant/30 py-xl px-margin"
      aria-labelledby="poster-heading"
    >
      <div class="max-w-7xl mx-auto text-center">
        <h2 id="poster-heading" class="font-headline text-headline-lg text-on-surface mb-sm">
          Hang beOI overal op
        </h2>
        <p class="text-body-lg font-body text-on-surface-variant max-w-2xl mx-auto mb-lg text-pretty">
          Download de affiche 2026–2027, print ze uit en hang ze op op school, bij een&nbsp;Coder&nbsp;Dojo of eender waar nieuwsgierige geesten samenkomen.
        </p>
        <ContestPoster
          lang="nl"
          label="Download de beOI-affiche 2026–2027 (PDF)"
          cta="Download de affiche"
          caption="Formaat A2 · PDF klaar om te printen"
        />
      </div>
    </section>
  </main>
  <Footer lang="nl" />
</BaseLayout>
