---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import { languageChooserByLocale, languagePickerLabels } from '../data/ui-i18n';
import type { Locale } from '../data/ui-i18n';

const chooserLocales: Locale[] = ['nl', 'fr', 'de', 'en'];
const wobblyClasses = [
  'wobbly-rotation-1',
  'wobbly-rotation-2',
  'wobbly-rotation-3',
  'wobbly-rotation-4',
];
---
<BaseLayout
  title="beOI – Olympiade belge d'Informatique / Belgische Informatica-olympiade / Belgische Informatik-Olympiade"
  description="Belgian Olympiad in Informatics (beOI) — choose your language: Nederlands, Français, Deutsch, or English."
  lang="fr"
>
  <script is:inline slot="head">
    (function () {
      if (location.search.indexOf('choose') !== -1) return;
      var langs = navigator.languages || (navigator.language ? [navigator.language] : []);
      for (var i = 0; i < langs.length; i++) {
        var code = String(langs[i]).slice(0, 2).toLowerCase();
        if (code === 'fr' || code === 'nl' || code === 'de') {
          location.replace('/' + code + '/');
          return;
        }
      }
    })();
  </script>

  <main id="main" class="min-h-screen flex flex-col items-center justify-center px-margin py-xl">
    <div class="w-full max-w-5xl mx-auto flex flex-col items-center gap-xl">
      <img
        src="/img/logo-beoi.png"
        alt="beOI"
        class="h-32 w-32 sm:h-40 sm:w-40 object-contain stamp-shadow"
        width="160"
        height="160"
      />

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-gutter w-full">
        {chooserLocales.map((locale, index) => (
          <article
            lang={locale}
            class:list={[
              'flex flex-col min-w-0 bg-surface-container-lowest border-2 border-outline-variant/40 rounded p-md gap-md',
              wobblyClasses[index],
            ]}
          >
            <p class="font-label text-label-md text-on-surface-variant uppercase tracking-wide flex-1 break-words">
              {languageChooserByLocale[locale].tagline}
            </p>
            <a
              href={`/${locale}/`}
              hreflang={locale}
              class="inline-flex items-center justify-center w-full min-h-11 text-center font-label text-label-md bg-primary text-on-primary px-md py-sm rounded-full border-2 border-primary hover:bg-primary/90 transition-colors no-underline break-words focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            >
              {languageChooserByLocale[locale].cta}
            </a>
            <span class="sr-only">{languagePickerLabels[locale]}</span>
          </article>
        ))}
      </div>
    </div>
  </main>

  <Footer lang="fr" />
</BaseLayout>
