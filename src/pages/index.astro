---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import { languageChooserByLocale, languagePickerLabels } from '../data/ui-i18n';
import type { Locale } from '../data/ui-i18n';

const chooserLocales: Locale[] = ['nl', 'fr', 'de', 'en'];
---
<BaseLayout
  title="beOI – Olympiade belge d'Informatique / Belgische Informatica-olympiade / Belgische Informatik-Olympiade"
  description="Belgian Olympiad in Informatics (beOI) — choose your language: Nederlands, Français, Deutsch, or English."
  lang="fr"
>
  <script is:inline slot="head">
    (function () {
      if (location.search.indexOf('choose') !== -1) return;
      var langs = navigator.languages || (navigator.language ? [navigator.language] : []);
      for (var i = 0; i < langs.length; i++) {
        var code = String(langs[i]).slice(0, 2).toLowerCase();
        if (code === 'fr' || code === 'nl' || code === 'de') {
          location.replace('/' + code + '/');
          return;
        }
      }
    })();
  </script>

  <div class="min-h-screen flex flex-col language-picker">
    <main id="main" class="flex-1 flex items-start lg:items-center px-margin py-md lg:py-lg">
      <div class="chooser">
        <div class="mast">
          <h1>
            <span class="sr-only">beOI</span>
            <img
              src="/img/logo-beoi.svg"
              alt=""
              class="logo"
              width="348"
              height="301"
              decoding="async"
              fetchpriority="high"
            />
          </h1>
        </div>

        <ul class="languages">
          {chooserLocales.map((locale) => (
            <li class="lang-row" lang={locale}>
              <div class="lang-copy">
                <p class="lang-label">{languagePickerLabels[locale]}</p>
                <p class="lang-title">{languageChooserByLocale[locale].name}</p>
              </div>
              <a
                href={`/${locale}/`}
                hreflang={locale}
                class="lang-cta"
              >
                {languageChooserByLocale[locale].cta}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </main>

    <Footer lang="fr" />
  </div>
</BaseLayout>

<style>
  .language-picker :global(footer) {
    margin-top: 0;
  }

  .chooser {
    width: 100%;
    max-width: 80rem;
    margin-inline: auto;
    display: grid;
    gap: 0;
  }

  .mast {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    text-align: center;
    padding-bottom: 2rem;
    border-bottom: 2px solid color-mix(in srgb, var(--color-primary) 35%, transparent);
  }

  .logo {
    display: block;
    width: 9.5rem;
    height: 9.5rem;
    object-fit: contain;
    font-size: 0;
    color: transparent;
  }

  .mast h1 {
    margin: 0;
  }

  .languages {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .lang-row {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.75rem;
    padding-block: 1rem;
    border-bottom: 2px solid var(--color-outline-variant);
    text-align: center;
  }

  .lang-row:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .lang-copy {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }

  .lang-label {
    margin: 0;
    font-family: var(--font-label);
    font-size: var(--text-label-md);
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0.05em;
    color: var(--color-on-surface);
  }

  .lang-title {
    margin: 0;
    min-width: 0;
    font-family: var(--font-body);
    font-size: var(--text-body-md);
    font-weight: 400;
    line-height: 1.4;
    color: var(--color-on-surface-variant);
  }

  .lang-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    width: 100%;
    min-height: 2.75rem;
    padding: 0.5rem 1.25rem;
    flex-shrink: 0;
    white-space: nowrap;
    border: 2px solid var(--color-primary);
    border-radius: 9999px;
    background: var(--color-primary);
    color: var(--color-on-primary);
    font-family: var(--font-label);
    font-size: var(--text-label-md);
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0.02em;
    text-align: center;
    text-decoration: none;
  }

  .lang-cta:hover {
    background: color-mix(in srgb, var(--color-primary) 90%, black);
    border-color: color-mix(in srgb, var(--color-primary) 90%, black);
  }

  @media (min-width: 40rem) {
    .logo {
      width: 12rem;
      height: 12rem;
    }

    .lang-row {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
      text-align: start;
    }

    .lang-cta {
      width: auto;
      min-width: 8.5rem;
    }
  }

  @media (min-width: 64rem) {
    .chooser {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 0;
      align-items: stretch;
    }

    .mast {
      padding: 1rem 3rem 1rem 0;
      border-bottom: 0;
      border-right: 2px solid color-mix(in srgb, var(--color-primary) 55%, transparent);
    }

    .logo {
      width: clamp(18rem, 33vh, 26rem);
      height: clamp(18rem, 33vh, 26rem);
    }

    .languages {
      padding-left: 3rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .lang-row {
      transition: border-color 180ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .lang-label {
      transition: color 180ms cubic-bezier(0.16, 1, 0.3, 1);
    }
  }

  .lang-row:hover,
  .lang-row:focus-within {
    border-bottom-color: var(--color-primary);
  }

  .lang-row:hover .lang-label,
  .lang-row:focus-within .lang-label {
    color: var(--color-primary);
  }
</style>
